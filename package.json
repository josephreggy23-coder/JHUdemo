{
  "name": "bodymaps-clinical-viewer",
  "version": "2.0.0",
  "private": true,
  "description": "A private, browser-based CT and segmentation review workspace for JHU BodyMaps.",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "tsc --noEmit && vite build --configLoader runner && node scripts/prepare-sites.mjs",
    "preview": "vite preview --configLoader runner",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@niivue/dicom-loader": "1.0.0",
    "@niivue/niivue": "0.69.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "prettier": "3.9.6",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
